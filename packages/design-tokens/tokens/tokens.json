{
  "$meta": {
    "name": "PaperMatch design tokens",
    "version": "0.1.0",
    "source": "PaperMatch_SPEC.md section 19 (デザインシステム) and section 20 (アクセシビリティ)",
    "note": "Single source of truth for colour, type, spacing and motion. Do not hardcode these values in app code."
  },
  "color": {
    "light": {
      "background": "#F5F6F8",
      "card": "#FFFFFF",
      "textPrimary": "#17202A",
      "textSecondary": "#667085",
      "accent": "#2F6FED",
      "saved": "#19A974",
      "formulaSurface": "#F0F4FF",
      "translationSurface": "#EEF8F4",
      "warning": "#D68C24",
      "border": "#E3E7EE",
      "overlay": "rgba(23, 32, 42, 0.55)"
    },
    "dark": {
      "background": "#0D1117",
      "card": "#151B24",
      "textPrimary": "#EDF2F7",
      "textSecondary": "#98A2B3",
      "accent": "#78A6FF",
      "saved": "#3FCB92",
      "formulaSurface": "#182033",
      "translationSurface": "#102820",
      "warning": "#E3A857",
      "border": "#232B37",
      "overlay": "rgba(0, 0, 0, 0.65)"
    }
  },
  "provenance": {
    "$note": "Section 11: provenance must never be signalled by colour alone. Every entry pairs a colour with an icon key and a text label.",
    "original": { "icon": "document-text", "labelKey": "provenance.original", "light": "#17202A", "dark": "#EDF2F7" },
    "verified_step": { "icon": "shield-check", "labelKey": "provenance.verifiedStep", "light": "#19A974", "dark": "#3FCB92" },
    "ai_explanation": { "icon": "sparkles", "labelKey": "provenance.aiExplanation", "light": "#2F6FED", "dark": "#78A6FF" },
    "assumption": { "icon": "question-mark-circle", "labelKey": "provenance.assumption", "light": "#D68C24", "dark": "#E3A857" },
    "human_reviewed": { "icon": "user-check", "labelKey": "provenance.humanReviewed", "light": "#6F42C1", "dark": "#B197FC" }
  },
  "typography": {
    "families": {
      "ui": "Inter, \"Noto Sans JP\", system-ui, sans-serif",
      "reading": "\"Source Serif 4\", Literata, Georgia, serif",
      "math": "\"STIX Two Math\", \"KaTeX_Main\", serif",
      "mono": "\"SFMono-Regular\", Menlo, Consolas, monospace"
    },
    "scale": {
      "title": { "fontSize": 24, "lineHeight": 32, "family": "reading", "weight": "600" },
      "abstract": { "fontSize": 17, "lineHeight": 27, "family": "reading", "weight": "400" },
      "body": { "fontSize": 16, "lineHeight": 24, "family": "ui", "weight": "400" },
      "label": { "fontSize": 13, "lineHeight": 18, "family": "ui", "weight": "500" },
      "caption": { "fontSize": 12, "lineHeight": 16, "family": "ui", "weight": "400" }
    },
    "dynamicType": {
      "minScale": 1.0,
      "maxScale": 2.0,
      "$note": "Section 20: text must survive scaling to 200% without clipping."
    }
  },
  "spacing": {
    "screenHorizontal": 20,
    "cardPadding": 24,
    "paragraphGap": 16,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "card": 20,
    "tile": 12,
    "chip": 999,
    "sheet": 24
  },
  "elevation": {
    "card": { "shadowOpacity": 0.08, "shadowRadius": 16, "shadowOffsetY": 4, "elevation": 3 },
    "sheet": { "shadowOpacity": 0.16, "shadowRadius": 24, "shadowOffsetY": -2, "elevation": 8 }
  },
  "motion": {
    "$note": "Section 19/20: every duration has a reduced-motion counterpart. Reduce Motion replaces continuous morphs with short fades.",
    "durations": { "instant": 0, "fast": 140, "base": 240, "slow": 420 },
    "reducedDurations": { "instant": 0, "fast": 0, "base": 120, "slow": 120 },
    "easing": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "decelerate": [0.0, 0.0, 0.0, 1.0],
      "gentle": [0.33, 0.0, 0.15, 1.0]
    },
    "swipe": {
      "commitThresholdRatio": 0.28,
      "velocityThreshold": 800,
      "maxRotationDeg": 8
    }
  },
  "haptics": {
    "$note": "Section 20: haptics must be disableable and never the only feedback channel.",
    "save": "impactLight",
    "skip": "selection",
    "undo": "impactMedium"
  },
  "a11y": {
    "minTouchTarget": 44,
    "minContrastBodyText": 4.5,
    "minContrastLargeText": 3.0,
    "$note": "Section 20: gestures always have an equivalent button; colour is never the only carrier of meaning."
  }
}

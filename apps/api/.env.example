# Copy to .env for local development. Never commit a real secret.

PAPERMATCH_ENVIRONMENT=development
PAPERMATCH_DATABASE_URL=postgresql+psycopg://papermatch:papermatch@localhost:5432/papermatch

# Required whenever ENVIRONMENT is not development/test — the app refuses to start with
# the built-in development value outside those environments.
PAPERMATCH_JWT_SECRET=dev-only-insecure-secret-change-me

# Provider selection (spec section 22). Phase 1 adds `arxiv` and `openalex`.
PAPERMATCH_PAPER_PROVIDER=mock
PAPERMATCH_TRANSLATION_PROVIDER=mock

# Used by the test suite; defaults to the value below when unset.
PAPERMATCH_TEST_DATABASE_URL=postgresql+psycopg://papermatch:papermatch@localhost:5432/papermatch_test
